{
  "schema_version": 1,
  "production_domain": "https://fr.rentbikehanoi.com",
  "target_new_articles": 500,
  "batch_size": 2,
  "first_pass_min_words": 1500,
  "first_pass_max_words": 3000,
  "first_pass_min_internal_links": 3,
  "first_pass_max_internal_links": 8,
  "max_repair_attempts": 2,
  "auto_claim_next": true,
  "stop_on_blocked": false,
  "draft_extension": ".article",
  "inbox_dir": "_factory/inbox",
  "review_dir": "_factory/review",
  "source_plan_path": "data/source-plan.xlsx",
  "matrix_path": "data/content-matrix.csv",
  "foundation_matrix_path": "data/seo-cluster-matrix.json",
  "writer_queue_path": "data/writer-queue.json",
  "state_path": "data/factory-state.json",
  "report_path": "reports/factory-last-run.json",
  "template_path": "site/templates/article.html",
  "title_min_chars": 45,
  "title_max_chars": 70,
  "meta_description_min_chars": 120,
  "meta_description_max_chars": 180,
  "seo_score_min": 85
}
